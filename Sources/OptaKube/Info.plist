<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>cloud.souris.optakube</string>
    <key>CFBundleName</key>
    <string>OptaKube</string>
    <key>CFBundleDisplayName</key>
    <string>OptaKube</string>
    <key>CFBundleExecutable</key>
    <string>OptaKube</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.5.0</string>
    <key>CFBundleVersion</key>
    <string>500</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSMainNibFile</key>
    <string></string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/souriscloud/optakube/master/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>4uTQZEdMy3jrq7GANt1oiPJuTk1q5pKHJLf6xMjiWz8=</string>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- OptaKube connects to user-specified Kubernetes API servers, signed by self-
         managed cluster CAs that ATS's default policy rejects even after our delegate
         approves the server trust (ATS also enforces cert-algorithm/TLS-version checks
         independent of trust evaluation). The kubeconfig CA is still pinned and
         verified via SecTrustEvaluateWithError in K8sAPIClient; ATS just steps aside. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
