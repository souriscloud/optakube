<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>cloud.souris.optakube</string>
    <key>CFBundleName</key>
    <string>OptaKube</string>
    <key>CFBundleDisplayName</key>
    <string>OptaKube</string>
    <key>CFBundleExecutable</key>
    <string>OptaKube</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.8.0</string>
    <key>CFBundleVersion</key>
    <string>800</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © Souris.CLOUD. MIT licensed.</string>
    <!-- macOS 15 gates local-network access for unsandboxed apps too, and for a Kubernetes
         client that is the common case: kind, minikube, k3d and most on-prem API servers
         live on 127.0.0.1 or a private range. Without a purpose string the user gets a
         bare, unexplained permission prompt — or an inexplicable connection failure. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>OptaKube connects to the Kubernetes clusters in your kubeconfig. Local clusters such as kind, minikube, or an on-premises API server are reached over your local network.</string>
    <key>NSMainNibFile</key>
    <string></string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/souriscloud/optakube/master/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>4uTQZEdMy3jrq7GANt1oiPJuTk1q5pKHJLf6xMjiWz8=</string>
    <!-- OptaKube connects to user-specified Kubernetes API servers, signed by self-
         managed cluster CAs that ATS's default policy rejects even after our delegate
         approves the server trust (ATS also enforces cert-algorithm/TLS-version checks
         independent of trust evaluation). The kubeconfig CA is still pinned and
         verified via SecTrustEvaluateWithError in K8sAPIClient; ATS just steps aside. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
