# OptaKube release credentials. Copy to scripts/.env and fill in.
# Never commit the real .env (it's gitignored).

# Apple Developer team ID (10-char alphanumeric).
TEAM_ID=

# Full Developer ID codesigning identity. Find with:
#   security find-identity -v -p codesigning
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Apple ID email used for notarization.
APPLE_ID="you@example.com"

# notarytool keychain profile name. Create once with:
#   xcrun notarytool store-credentials "notarytool" \
#       --apple-id <APPLE_ID> --team-id <TEAM_ID> --password <app-specific-password>
NOTARYTOOL_PROFILE="notarytool"

# GitHub repo (owner/repo). DMGs are uploaded as release assets; the appcast is
# served from the default branch via raw.githubusercontent.com.
GITHUB_REPO="souriscloud/optakube"
